# =============================================================================
# Ghostty Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Font
# -----------------------------------------------------------------------------

# font-family = VictorMono NerdFont Mono
font-family = Ioskeley Mono
font-size = 16

# Render italics in the Light weight of Ioskeley Mono.
# Render italics in the Medium weight of Ioskeley Mono.
# Neovim italicizes comments, keywords and types (see nvim-minimax
# 'plugin/30_mini.lua'), so this is the face those use.
#
# Was 'Light Italic', which made comments both dim and thin - the thinnest face
# in the family, on a 0.93-opacity background, with 'font-thicken' off. Medium
# sits above the Regular weight of surrounding code, so italic text reads
# clearly without relying on colour contrast alone.
font-style-italic = Medium Italic

# NOTE: 'Ioskeley Mono' is a STATIC font family (no variable 'fvar' axes),
# unlike the previous 'Monaspace Neon Var'. So weights must be chosen by style
# name via 'font-style*', NOT via 'font-variation', which only affects variable
# fonts and would silently do nothing here.
#
# Available styles: Thin, Extralight, Light, SemiLight, (Regular), Medium,
# Semibold, Bold, Extrabold, Heavy - each with an Italic counterpart.
# To make normal text light as well, uncomment:
# font-style = Light
# font-variation = wght=300

# font-thicken = true

window-title-font-family = "Maple Mono"

# -----------------------------------------------------------------------------
# Window
# -----------------------------------------------------------------------------
background-opacity = 0.93
background-blur-radius = 50
maximize = true
window-padding-balance = true


# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
window-titlebar-background = 090B10
macos-titlebar-style=tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
macos-non-native-fullscreen = true

# -----------------------------------------------------------------------------
# Shell
# -----------------------------------------------------------------------------
shell-integration = zsh

# -----------------------------------------------------------------------------
# Splits
# -----------------------------------------------------------------------------
unfocused-split-opacity = 0.8
focus-follows-mouse = true

# -----------------------------------------------------------------------------
# Quick Terminal
# -----------------------------------------------------------------------------
quick-terminal-position = right
quick-terminal-size = 50%,100%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0
window-save-state = never

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------
theme = Atom One Dark

# -----------------------------------------------------------------------------
# Keybindings — General
# -----------------------------------------------------------------------------
keybind = ctrl+z=close_surface
keybind = ctrl+shift+alt+t=toggle_quick_terminal
keybind = ctrl+t>h=toggle_quick_terminal
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+o=toggle_tab_overview

# Splits
keybind = ctrl+shift+v=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+M=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+right=resize_split:right,20
keybind = ctrl+shift+left=resize_split:left,20
keybind = super+l=goto_split:right
keybind = super+h=goto_split:left

# Word/line navigation
keybind = alt+left=text:\x1b[1;3D
keybind = alt+right=text:\x1b[1;3C
keybind = cmd+left=text:\x1b[H
keybind = cmd+right=text:\x1b[F

# tmux window switching
# keybind = ctrl+tab=text:\x01L
# keybind = ctrl+shift+tab=text:\x01H

# Pane switching is handled natively by herdr, which accepts multiple bindings
# per action (see the [keys] section of ~/.config/herdr/config.toml):
#   focus_pane_left = ["prefix+h", "ctrl+alt+h"]
# These Ghostty `text:\x01h` chords were a tmux-era workaround that injected the
# raw prefix byte (\x01 = Ctrl+A) followed by a direction. Injecting bytes meant
# the chords fired even in apps that had nothing to do with the multiplexer.
# keybind = ctrl+alt+shift+h=text:\x01h
# keybind = ctrl+alt+shift+j=text:\x01j
# keybind = ctrl+alt+shift+k=text:\x01k
# keybind = ctrl+alt+shift+l=text:\x01l

# -----------------------------------------------------------------------------
# Keybindings — Vim Mode
# -----------------------------------------------------------------------------
keybind = alt+v=activate_key_table:vim
keybind = vim/

# Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next

# Copy
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard

# Command palette
keybind = vim/shift+semicolon=toggle_command_palette

# Exit vim mode
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table
keybind = vim/catch_all=ignore
