{
  "Typed Fetch Function": {
    "prefix": "fetch",
    "body": [
      "export async function fetch${1:Data}(): Promise<${2:Type}> {",
      "  const response = await fetch('${3:/api/endpoint}');",
      "  if (!response.ok) throw new Error('Failed to fetch');",
      "  return response.json();",
      "}"
    ],
    "description": "Typed fetch function with error handling"
  },
  "Record Type": {
    "prefix": "rcd",
    "body": [
      "export const ${1:record}: Record<${2:string}, ${3:number}> = {",
      "  ${4:key}: ${5:value},",
      "};"
    ],
    "description": "Record utility type"
  },
  "New Type Alias": {
    "prefix": "talias",
    "body": ["type ${1:TypeName} = {", "  ${2:key}: ${3:type};", "};"],
    "description": "Create a new type alias"
  },
  "New Interface": {
    "prefix": "tsi",
    "body": ["interface ${1:InterfaceName} {", "  ${2:key}: ${3:type};", "}"],
    "description": "Create a new interface"
  },
  "Function Declaration": {
    "prefix": "fn",
    "body": ["function ${1:fnName}(${2:args}): ${3:void} {", "  $0", "}"],
    "description": "Function boilerplate"
  },
  "Arrow Function": {
    "prefix": "afn",
    "body": ["const ${1:fnName} = (${2:args}): ${3:void} => {", "  $0", "};"],
    "description": "Arrow function boilerplate"
  },
  "Try/Catch": {
    "prefix": "tc",
    "body": [
      "try {",
      "  $0",
      "} catch (err: unknown) {",
      "  if (err instanceof Error) {",
      "    console.error(err.message);",
      "  }",
      "}"
    ],
    "description": "try/catch block"
  },
  "Module Export": {
    "prefix": "exp",
    "body": ["export {", "  $0", "};"],
    "description": "Export members"
  },
  "Import Statement": {
    "prefix": "imp",
    "body": ["import { ${1:thing} } from '${2:module}';"],
    "description": "Import from a module"
  },
  "Zod Schema With Inferred Type": {
    "prefix": "zschema",
    "body": [
      "const ${1:schemaName}Schema = z.object({",
      "  ${2:name}: z.string().min(1, '${3:Required}'),",
      "});",
      "",
      "type ${4:SchemaName}Values = z.infer<typeof ${1:schemaName}Schema>;"
    ],
    "description": "Zod object schema with inferred TypeScript type"
  },
  "React Hook Form With Zod": {
    "prefix": "rhfz",
    "body": [
      "const form = useForm<${1:FormValues}>({",
      "  resolver: zodResolver(${2:formSchema}),",
      "  defaultValues: {",
      "    ${3:name}: '',",
      "  },",
      "});"
    ],
    "description": "react-hook-form setup with zodResolver"
  },
  "TanStack Query Factory": {
    "prefix": "qfactory",
    "body": [
      "export const ${1:resource}Queries = {",
      "  all: () => ['${1:resource}'] as const,",
      "  list: (${2:params}?: ${3:ListParams}) => ['${1:resource}', ${2:params}] as const,",
      "  listOptions: (${2:params}?: ${3:ListParams}) =>",
      "    queryOptions({",
      "      queryKey: ${1:resource}Queries.list(${2:params}),",
      "      queryFn: () => ${4:api}.${1:resource}.list(${2:params}),",
      "    }),",
      "};"
    ],
    "description": "TanStack Query query factory pattern"
  },
  "useQuery From Factory": {
    "prefix": "uqf",
    "body": [
      "const { data: ${1:data}, isLoading } = useQuery(",
      "  ${2:resource}Queries.${3:listOptions}(${4:params})",
      ");"
    ],
    "description": "useQuery using query factory options"
  }
}
