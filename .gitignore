# macOS noise
.DS_Store

# chezmoi links individual files, so runtime state (logs, sockets, sessions,
# approvals, editor backups) stays in $HOME and never lands here.

# This repo is public. Never `chezmoi add` these (see README "Never add
# these"), but ignore them by name anyway so adding a whole config dir later
# cannot commit a live token.
**/.npmrc
**/hosts.yml
**/auth.json
**/auth.db*
**/apps.json
**/.gitconfig-personal
