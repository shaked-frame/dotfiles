<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps ~/.config/rex/scripts/notify.lua listening to every Rex session.
  Symlinked into ~/Library/LaunchAgents. Load / unload:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.shakedhagag.rex-notify.plist
    launchctl bootout   gui/$(id -u)/com.shakedhagag.rex-notify
  autostart=false: never start a Rex server from here; until the app has one
  running the script exits and launchd retries every ThrottleInterval seconds.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shakedhagag.rex-notify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/shakedhagag/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex</string>
    <string>--autostart=false</string>
    <string>do</string>
    <string>/Users/shakedhagag/.config/rex/scripts/notify.lua</string>
    <string>--all</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/shakedhagag/Library/Logs/rex-notify.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shakedhagag/Library/Logs/rex-notify.log</string>
</dict>
</plist>
