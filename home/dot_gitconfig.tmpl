{{- /* Machine type comes from `chezmoi init`; see .chezmoi.toml.tmpl. */ -}}
[user]
	name = Shaked Hagag
{{- if eq .machine "work" }}
	email = {{ .workEmail }}
	signingkey = 22758DF495FF66E0

# Personal repos on the work Mac: personal email and SSH key, from the
# untracked ~/.gitconfig-personal. The dotfiles repo is one of them.
[includeIf "gitdir:~/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.gitconfig-personal
{{- else }}
	email = {{ .personalEmail }}
{{- end }}

[init]
	defaultBranch = main
{{- if eq .machine "work" }}
[coderabbit]
	machineId = cli/6f19f0407ccd4fb3a06c16117a405847
{{- end }}
[fetch]
	prune = true
[alias]
	fix-refs = !cd \"$(git rev-parse --show-toplevel)\" && rm -rf .git/refs/remotes/origin && mkdir -p .git/refs/remotes/origin && grep -v \" refs/remotes/origin/\" .git/packed-refs > .git/packed-refs.tmp && mv .git/packed-refs.tmp .git/packed-refs && git fetch origin
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true

# ── delta ─────────────────────────────────────────────────────────────────────
# Delta config lives here only, shared between terminal git and lazygit.
# lazygit omits --no-gitconfig on purpose, so it inherits everything below and
# overrides only what has to differ. See git.diffRenderers in
# ~/.config/lazygit/config.yml for --paging=never, --hunk-header-style=omit,
# and the lazygit-edit:// file link format.
[core]
	pager = delta

[interactive]
	# Styles the hunks in `git add -p` / `git checkout -p`.
	diffFilter = delta --color-only

[pager]
	# With hyperlinks = true below, each blame commit links to GitHub.
	blame = delta

[delta]
	# Delta's terminal-background auto-detection does not work in every context;
	# its docs single out lazygit specifically, so state this explicitly.
	dark = true
	# n / N jump between files (and commit boundaries in `git log -p`).
	# Inert under lazygit, which runs delta with --paging=never.
	navigate = true
	line-numbers = true
	# Commit hashes become links to GitHub/GitLab. lazygit overrides only the
	# *file* link format, so terminal git keeps delta's default there.
	hyperlinks = true
	# Matches gui.tabWidth = 4 in lazygit. Delta defaults to 8, which is what
	# made tabs render at two different widths inside vs outside the diff pane.
	tabs = 4

# Diff and syntax colors: Solarized Osaka, matching Neovim. Generated by
# scripts/gen-themes.lua; syntax-theme needs bat's cache (chezmoi rebuilds it).
[include]
	path = ~/.config/delta/solarized-osaka.gitconfig

[merge]
	# Includes the merge base in conflict markers, which delta renders as two
	# diffs (base -> ours, base -> theirs).
	conflictStyle = zdiff3

[diff]
	tool = codediff
[difftool "codediff"]
	cmd = nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff --exit-on-close file $LOCAL $REMOTE\"
