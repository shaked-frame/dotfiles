    "when": "editorTextFocus || terminalFocus"
  },
  {
    "key": "space x q",
    "command": "workbench.actions.view.problems",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space x r",
    "command": "references-view.findReferences",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  }
]
