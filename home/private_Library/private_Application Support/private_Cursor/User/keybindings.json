[
  //
  // DISABLE CURSOR AI OVERRIDES ON CTRL+L / CTRL+K / CTRL+I
  // (These commands intercept the key before our navigation bindings can fire.)
  //
  {
    "key": "ctrl+l",
    "command": "-aichat.newchataction"
  },
  {
    "key": "ctrl+k",
    "command": "-aipopup.action.modal.generate"
  },
  {
    "key": "ctrl+i",
    "command": "-composer.startComposerPrompt"
  },
  {
    "key": "ctrl+i",
    "command": "-aichat.newfollowupaction"
  },

  //
  // NVIM-STYLE PANE NAVIGATION (mini.basics `<C-hjkl>`)
  //
  // navigate* only walks editor groups. The file tree and the agent (secondary
  // side bar) need their own edge commands. A later binding wins when its
  // `when` is more specific, so do not add a broader ctrl+h/l below these.
  //
  // vim.handleKeys marks <C-hjkl> as handled by VS Code (see settings.json).
  //
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "editorTextFocus && !terminalFocus && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/ && !suggestWidgetVisible && !inQuickOpen && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !findWidgetVisible"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "editorTextFocus && !terminalFocus && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/ && !suggestWidgetVisible && !inQuickOpen && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !findWidgetVisible"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "editorTextFocus && !terminalFocus && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/ && !suggestWidgetVisible && !inQuickOpen && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !findWidgetVisible"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "editorTextFocus && !terminalFocus && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/ && !suggestWidgetVisible && !inQuickOpen && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !findWidgetVisible"
  },
  // navigate* stays inside editor groups. These two fire only at the outer
  // edges: leftmost group → file tree, last group → agent.
  {
    "key": "ctrl+h",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "editorTextFocus && !terminalFocus && activeEditorGroupIndex == 1 && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/ && !suggestWidgetVisible && !inQuickOpen && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !findWidgetVisible"
  },
  {
    "key": "ctrl+l",
    "command": "composer.startComposerPrompt",
    "when": "editorTextFocus && !terminalFocus && activeEditorGroupLast && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/ && !suggestWidgetVisible && !inQuickOpen && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !findWidgetVisible"
  },
  // File tree sits left of the editor.
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "(filesExplorerFocus || sideBarFocus) && !agentsPaneFocused && !composerFocused && !auxiliaryBarFocus && !inputFocus && !inQuickOpen"
  },
  // On Mac, ctrl+h is also Backspace while a text input is focused (deleteLeft).
  // The agent input sets composerFocused, same as Cmd+I. This has to win over
  // that Backspace binding, so keep the when to composerFocused only.
  {
    "key": "ctrl+h",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusActiveEditorGroup",
        "workbench.action.focusActiveEditorGroup"
      ]
    },
    "when": "composerFocused"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "(terminalFocus || panelFocus) && !inQuickOpen && !suggestWidgetVisible && !inputFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "(terminalFocus || panelFocus) && !inQuickOpen && !suggestWidgetVisible && !inputFocus"
  },
  // LazyGit is an editor-tab terminal. From the rightmost group, ctrl+l
  // continues into the agent instead of stopping on navigateRight.
  {
    "key": "ctrl+l",
    "command": "composer.startComposerPrompt",
    "when": "terminalFocus && activeEditorGroupLast && !inQuickOpen && !suggestWidgetVisible && !inputFocus"
  },
  // Cmd+L is the key that actually reaches the agent. Vim takes Ctrl+L first.
  // From the editor this is the built-in Open Chat command. From the agent it
  // returns to the editor instead of closing the sidebar.
  {
    "key": "cmd+l",
    "command": "aichat.newchataction",
    "when": "editorTextFocus && !composerFocused && !auxiliaryBarFocus && !agentsPaneFocused"
  },
  {
    "key": "cmd+l",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusActiveEditorGroup",
        "workbench.action.focusActiveEditorGroup"
      ]
    },
    "when": "composerFocused || auxiliaryBarFocus || agentsPaneFocused"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "(terminalFocus || panelFocus) && !inQuickOpen && !suggestWidgetVisible && !inputFocus"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "(terminalFocus || panelFocus) && !inQuickOpen && !suggestWidgetVisible && !inputFocus"
  },
  {
    "key": "ctrl+q",
    "command": "workbench.action.closeAllEditors",
    "when": "inEditorsPicker"
  },
  {
    "key": "space m",
    "command": "workbench.action.toggleMaximizeEditorGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space =",
    "command": "workbench.action.evenEditorWidths",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "s h",
    "command": "workbench.action.moveEditorToLeftGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "s l",
    "command": "workbench.action.moveEditorToRightGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space n t",
    "command": "editor.emmet.action.matchTag",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space n b",
    "command": "editor.action.jumpToBracket",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "s v",
    "command": "workbench.action.splitEditor",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "s s",
    "command": "workbench.action.splitEditorDown",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },

  //
  // CODING
  //
  {
    "key": "g r a",
    "command": "editor.action.codeAction",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "shift-k",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && vim.active && vim.mode == 'VisualLine'"
  },
  {
    "key": "shift-j",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && vim.active && vim.mode == 'VisualLine'"
  },
  {
    "key": "shift-k",
    "command": "editor.action.showHover",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "g r n",
    "command": "editor.action.rename",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g s",
    "command": "workbench.action.gotoSymbol",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space b d",
    "command": "workbench.action.closeActiveEditor",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space b o",
    "command": "workbench.action.closeOtherEditors",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space space",
    "command": "workbench.action.showAllEditors",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space f b",
    "command": "workbench.action.showAllEditors",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space s f",
    "command": "workbench.action.quickOpen",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "g r d",
    "command": "editor.action.revealDefinition",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "g r r",
    "command": "editor.action.goToReferences",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "g r i",
    "command": "runCommands",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'",
    "args": {
      "commands": ["workbench.action.splitEditor", "editor.action.goToImplementation"]
    }
  },
  {
    "key": "g r v",
    "command": "runCommands",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'",
    "args": {
      "commands": ["workbench.action.splitEditor", "editor.action.goToReferences"]
    }
  },
  {
    "key": "g D",
    "command": "editor.action.revealDeclaration",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "g y",
    "command": "editor.action.goToTypeDefinition",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space s g",
    "command": "workbench.action.findInFiles",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g g",
    "command": "workbench.action.terminal.newWithProfile",
    "args": {
      "profileName": "lazygit",
      "location": "editor"
    },
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g d",
    "command": "git.openChange",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g o",
    "command": "git.openChange",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g l",
    "command": "workbench.scm.history.focus",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g r",
    "command": "git.revertSelectedRanges",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g b",
    "command": "git.blame.toggleEditorDecoration",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space m f",
    "command": "workbench.view.scm",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g w",
    "command": "git.createWorktree",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space g u",
    "command": "git.viewChanges",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl-n",
    "command": "editor.action.nextMatchFindAction",
    "when": "editorTextFocus && vim.active && (vim.mode == 'Normal' || vim.mode == 'Visual')"
  },

  //
  // SUGGESTIONS AND AUTOCOMPLETION
  //
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+y",
    "command": "acceptSelectedSuggestion",
    "when": "suggestWidgetVisible"
  },

  //
  // BUFFER/TAB NAVIGATION
  //
  {
    "key": "] b",
    "command": "workbench.action.nextEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "[ b",
    "command": "workbench.action.previousEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "[ t",
    "command": "workbench.action.moveEditorToPreviousGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "] t",
    "command": "workbench.action.moveEditorToNextGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "[ d",
    "command": "editor.action.marker.prevInFiles",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "] d",
    "command": "editor.action.marker.nextInFiles",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "[ h",
    "command": "workbench.action.editor.previousChange",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "] h",
    "command": "workbench.action.editor.nextChange",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space b a",
    "command": "workbench.action.openPreviousRecentlyUsedEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+shift+alt+meta+-",
    "command": "workbench.action.toggleEditorWidths",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },

  //
  // FILE EXPLORER
  //
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "s",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "shift-s",
    "command": "runCommands",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
    "args": {
      "commands": [
        "workbench.action.splitEditorDown",
        "explorer.openAndPassFocus",
        "workbench.action.closeOtherEditors"
      ]
    }
  },
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && explorerResourceIsFolder && !inputFocus"
  },

  //
  // FILE EXPLORER NAVIGATION
  //
  {
    "key": "h",
    "command": "list.collapse",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus"
  },

  //
  // DEBUG
  //
  {
    "key": "space d a",
    "command": "workbench.action.debug.selectandstart",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && debuggersAvailable"
  },
  {
    "key": "space d t",
    "command": "workbench.action.debug.stop",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && !focusedSessionIsAttached"
  },
  {
    "key": "space d o",
    "command": "workbench.action.debug.stepOver",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
  },
  {
    "key": "space d i",
    "command": "workbench.action.debug.stepInto",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
  },
  {
    "key": "space d b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space d e",
    "command": "editor.debug.action.showDebugHover",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
  },
  {
    "key": "space d c",
    "command": "workbench.action.debug.continue",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && inDebugMode && debugState == 'stopped'"
  },

  //
  // COMPOSER/AI
  //
  {
    "key": "shift+h",
    "command": "workbench.action.previousEditor",
    "when": "vim.active && vim.mode != 'Insert' && editorFocus"
  },
  {
    "key": "shift+l",
    "command": "workbench.action.nextEditor",
    "when": "vim.active && vim.mode != 'Insert' && editorFocus"
  },

  //
  // TERMINAL
  //
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+;",
    "command": "workbench.action.terminal.focus"
  },
  {
    "key": "ctrl+;",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "cmd+0",
    "command": "multiCommand.toggleMaximizedPanelAndFocusTerminal"
  },

  //
  // NAVIGATION HISTORY
  //
  {
    "key": "ctrl+o",
    "command": "workbench.action.navigateBack",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+i",
    "command": "workbench.action.navigateForward",
    "when": "!terminalFocus"
  },

  //
  // BOOKMARKS
  //
  {
    "key": "space h",
    "command": "bookmarks.toggle",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "space b b",
    "command": "bookmarks.list",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },

  //
  // VIM ARROW KEY DISABLES
  //
  {
    "key": "up",
    "command": "-extension.vim_up",
    "when": "editorTextFocus && vim.active && !inDebugRepl && !parameterHintsVisible && !suggestWidgetVisible"
  },
  {
    "key": "down",
    "command": "-extension.vim_down",
    "when": "editorTextFocus && vim.active && !inDebugRepl && !parameterHintsVisible && !suggestWidgetVisible"
  },
  {
    "key": "right",
    "command": "-extension.vim_right",
    "when": "editorTextFocus && vim.active && !inDebugRepl"
  },
  {
    "key": "left",
    "command": "-extension.vim_left",
    "when": "editorTextFocus && vim.active && !inDebugRepl"
  },
  {
    "key": "escape",
    "command": "extension.vim_escape",
    "when": "editorTextFocus && vim.active && !inDebugRepl && !suggestWidgetVisible"
  },
  {
    "key": "escape",
    "command": "-extension.vim_escape",
    "when": "editorTextFocus && vim.active && !inDebugRepl"
  },
  {
    "key": "shift+tab",
    "command": "-extension.vim_shift+tab",
    "when": "editorTextFocus && vim.active && !inDebugRepl && vim.mode != 'Insert'"
  },
  {
    "key": "tab",
    "command": "-extension.vim_tab",
    "when": "editorTextFocus && vim.active && !inDebugRepl && vim.mode != 'Insert'"
  },

  //
  // Hyper (ZSA Voyager), same as nvim:
  // Hyper+p → next hunk, Hyper+\ → next diagnostic.
  // Chromium sometimes keeps Shift on these, so both forms are bound.
  //
  {
    "key": "ctrl+alt+cmd+p",
    "command": "editor.action.dirtydiff.next",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+alt+cmd+p",
    "command": "editor.action.dirtydiff.next",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+cmd+\\",
    "command": "editor.action.marker.next",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+alt+cmd+\\",
    "command": "editor.action.marker.next",
    "when": "editorTextFocus"
  },

  //
  // DIFF NAVIGATION
  //
  {
    "key": "ctrl+shift+alt+meta+'",
    "command": "workbench.action.compareEditor.previousChange",
    "when": "textCompareEditorVisible"
  },
  {
    "key": "ctrl+shift+alt+meta+\\",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "textCompareEditorVisible"
  },

  //
  // EDITOR RESIZE
  //
  {
    "key": "ctrl+shift+up",
    "command": "workbench.action.increaseViewHeight",
    "when": "vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+down",
    "command": "workbench.action.decreaseViewHeight",
    "when": "vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+left",
    "command": "workbench.action.decreaseViewWidth",
    "when": "vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+right",
    "command": "workbench.action.increaseViewWidth",
    "when": "vim.active && vim.mode == 'Normal'"
  },
  // Hyper (ZSA Voyager) resize. Neovim sees these as <M-C-D-7/8/9/0> because
  // it drops Shift on digits; Chromium may keep Shift, so both forms are bound.
  {
    "key": "ctrl+alt+cmd+8",
    "command": "workbench.action.increaseViewWidth"
