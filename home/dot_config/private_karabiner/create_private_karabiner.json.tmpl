{{- /*
  Karabiner-Elements config. `create_`: chezmoi writes it only when it is
  missing, so a new Mac starts with Caps Lock as Hyper and Karabiner owns the
  file after that (its UI rewrites it). `.tmpl` makes it a copy: in symlink
  mode Karabiner's save would replace the link anyway.
  Hold Caps Lock = cmd+ctrl+opt+shift, the same chord the Voyager's Hyper key
  sends; tap alone switches ABC <-> Hebrew (Karabiner takes the key, so
  macOS "Caps Lock switches input source" no longer sees it). The Voyager has no Caps Lock, so it is untouched.
*/ -}}
{
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock: hold for Hyper (cmd+ctrl+opt+shift, like the Voyager), tap to switch ABC <-> Hebrew",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_shift",
                    "modifiers": [
                      "left_command",
                      "left_control",
                      "left_option"
                    ]
                  }
                ],
                "to_if_alone": [
                  {
                    "select_input_source": {
                      "input_source_id": "^com\\.apple\\.keylayout\\.ABC$"
                    }
                  }
                ],
                "conditions": [
                  {
                    "type": "input_source_if",
                    "input_sources": [
                      {
                        "input_source_id": "^com\\.apple\\.keylayout\\.Hebrew$"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_shift",
                    "modifiers": [
                      "left_command",
                      "left_control",
                      "left_option"
                    ]
                  }
                ],
                "to_if_alone": [
                  {
                    "select_input_source": {
                      "input_source_id": "^com\\.apple\\.keylayout\\.Hebrew$"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
